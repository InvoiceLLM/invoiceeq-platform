ss="w-full bg-[#1A2230] border border-[#222D3D] hover:border-[#3B82F6]/50 rounded-lg py-2 px-3 text-xs text-slate-300 focus:outline-none focus:border-[#3B82F6] transition-all cursor-pointer"><option value="">All Tags</option><option value="steel">#steel</option></select></div><div class="flex flex-col gap-1 min-w-[130px]"><select class="w-full bg-[#1A2230] border border-[#222D3D] hover:border-[#3B82F6]/50 rounded-lg py-2 px-3 text-xs text-slate-300 focus:outline-none focus:border-[#3B82F6] transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:border-[#222D3D]"><option value="">All Statuses</option><option value="PROCESSING">Processing</option><option value="COMPLETED">Completed</option><option value="AUDIT_REQUIRED">Audit Required</option><option value="REVIEW_LATER">Review Later</option><option value="NEEDS_RESUBMISSION">Needs Resubmission</option><option value="PAID">Paid</option><option value="REJECTED">Rejected</option><option value="DUPLICATE">Duplicate</option><option value="FAILED">Failed</option></select></div><button class="flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all border bg-accent-blue/15 hover:bg-accent-blue/25 border-accent-blue/30 hover:border-accent-blue/50 text-[#3B82F6]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-save w-3.5 h-3.5"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>Save Filter</button></div></div><div class="glass-panel rounded-xl overflow-hidden flex flex-col h-full border border-[#222D3D]"><div class="p-6 border-b border-[#222D3D] flex items-center justify-between"><div><h3 class="text-sm font-semibold text-white tracking-wide">Recent Invoices</h3><p class="text-xs text-slate-400">Audit history status and processing ledger.</p></div><div class="flex items-center gap-1 bg-[#0B0F19] border border-[#222D3D] rounded-lg p-1"><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors bg-[#3B82F6] text-white">All</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Review Required</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Paid</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Pending</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Rejected</button></div></div><div class="overflow-x-auto overflow-y-auto"><table class="w-full text-left border-collapse"><thead><tr class="sticky top-0 z-10 border-b border-[#222D3D] bg-[#0F172A] text-slate-400 text-[10px] font-bold uppercase tracking-wider select-none"><th class="px-3 lg:px-4 py-3.5">Invoice #</th><th class="px-3 lg:px-4 py-3.5">Client / Vendor</th><th class="px-3 lg:px-4 py-3.5">Issue Date</th><th class="px-3 lg:px-4 py-3.5">Ingest Date</th><th class="px-3 lg:px-4 py-3.5">Due Date</th><th class="px-3 lg:px-4 py-3.5">Amount</th><th class="px-3 lg:px-4 py-3.5">AI Status</th><th class="px-3 lg:px-4 py-3.5 text-right">Actions</th></tr></thead><tbody class="divide-y divide-[#222D3D]/50 text-slate-300 text-xs"><tr class="hover:bg-slate-900/30 transition-colors duration-150 group cursor-pointer"><td class="px-3 lg:px-4 py-4 font-mono font-medium text-white group-hover:text-[#3B82F6] transition-colors">IN-ALL</td><td class="px-3 lg:px-4 py-4"><span class="font-semibold text-slate-200">Rajesh Steel</span><div class="flex flex-wrap gap-1 opacity-0 max-h-0 overflow-hidden group-hover:opacity-100 group-hover:max-h-16 group-hover:mt-1.5 transition-all duration-300 ease-in-out"><span class="text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-slate-400 border border-[#222D3D]">#steel</span></div></td><td class="px-3 lg:px-4 py-4 font-medium text-slate-400">-</td><td class="px-3 lg:px-4 py-4 font-medium text-slate-400">—</td><td class="px-3 lg:px-4 py-4 font-medium text-slate-400">—</td><td class="px-3 lg:px-4 py-4 font-bold text-slate-200 font-mono">$0.00</td><td class="px-3 lg:px-4 py-4"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/25 text-emerald-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big w-3.5 h-3.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>Paid</span></td><td class="px-3 lg:px-4 py-4 text-right"><div class="inline-flex items-center justify-end gap-1"><a href="/invoices/review/in-0" title="Open Auditor Review Console" aria-label="Review invoice IN-ALL" class="inline-flex items-center gap-1 rounded-lg p-1.5 text-xs font-semibold text-[#3B82F6] transition-colors hover:bg-slate-800 hover:text-[#3B82F6]/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye w-3.5 h-3.5"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></a><button type="button" title="Delete invoice" aria-label="Delete invoice IN-ALL" class="inline-flex items-center rounded-lg p-1.5 text-rose-400 transition-colors hover:bg-rose-500/10 hover:text-rose-300 disabled:cursor-wait disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 w-3.5 h-3.5"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></div></td></tr></tbody></table></div><div class="flex items-center justify-between px-6 py-3 border-t border-[#222D3D] text-xs text-slate-400"><span>Page 1 of 3 (20 invoices)</span><div class="flex items-center gap-2"><button disabled="" class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-[#222D3D] text-slate-300 hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left w-3.5 h-3.5"><path d="m15 18-6-6 6-6"></path></svg> Previous</button><button class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-[#222D3D] text-slate-300 hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">Next <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-3.5 h-3.5"><path d="m9 18 6-6-6-6"></path></svg></button></div></div></div></div>"`;
