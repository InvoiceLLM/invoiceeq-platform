exports[`InvoiceTable direction=in — parity with RecentInvoicesTable > rows, full page 1`] = `"<div class="glass-panel rounded-xl overflow-hidden flex flex-col h-full border border-[#222D3D]"><div class="p-6 border-b border-[#222D3D] flex items-center justify-between"><div><h3 class="text-sm font-semibold text-white tracking-wide">Recent Invoices</h3><p class="text-xs text-slate-400">Audit history status and processing ledger.</p></div><div class="flex items-center gap-1 bg-[#0B0F19] border border-[#222D3D] rounded-lg p-1"><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">All</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors bg-[#3B82F6] text-white">Review Required</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Paid</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Pending</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Rejected</button></div></div><div class="overflow-x-auto overflow-y-auto"><table class="w-full text-left border-collapse"><thead><tr class="sticky top-0 z-10 border-b border-[#222D3D] bg-[#0F172A] text-slate-400 text-[10px] font-bold uppercase tracking-wider select-none"><th class="px-3 lg:px-4 py-3.5">Invoice #</th><th class="px-3 lg:px-4 py-3.5">Client / Vendor</th><th class="px-3 lg:px-4 py-3.5">Issue Date</th><th class="px-3 lg:px-4 py-3.5">Ingest Date</th><th class="px-3 lg:px-4 py-3.5">Due Date</th><th class="px-3 lg:px-4 py-3.5">Amount</th><th class="px-3 lg:px-4 py-3.5">AI Status</th><th class="px-3 lg:px-4 py-3.5 text-right">Actions</th></tr></thead><tbody class="divide-y divide-[#222D3D]/50 text-slate-300 text-xs"><tr class="hover:bg-slate-900/30 transition-colors duration-150 group cursor-pointer"><td class="px-3 lg:px-4 py-4 font-mono font-medium text-white group-hover:text-[#3B82F6] transition-colors">RAJ-2008</td><td class="px-3 lg:px-4 py-4"><span class="font-semibold text-slate-200">Rajesh Steel</span><div class="flex flex-wrap gap-1 opacity-0 max-h-0 overflow-hidden group-hover:opacity-100 group-hover:max-h-16 group-hover:mt-1.5 transition-all duration-300 ease-in-out"><span class="text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-slate-400 border border-[#222D3D]">#steel</span><span class="text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-slate-400 border border-[#222D3D]">#q3</span></div></td><td class="px-3 lg:px-4 py-4 font-medium text-slate-400">Aug 2, 2026</td><td class="px-3 lg:px-4 py-4 font-medium text-slate-400">Aug 3, 2026</td><td class="px-3 lg:px-4 py-4 font-medium text-slate-400">Sep 1, 2026</td><td class="px-3 lg:px-4 py-4 font-bold text-slate-200 font-mono">₹220,000.00</td><td class="px-3 lg:px-4 py-4"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 border border-amber-500/25 text-amber-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert w-3.5 h-3.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>Review Required</span></td><td class="px-3 lg:px-4 py-4 text-right"><div class="inline-flex items-center justify-end gap-1"><a href="/invoices/review/a1" title="Open Auditor Review Console" aria-label="Review invoice RAJ-2008" class="inline-flex items-center gap-1 rounded-lg p-1.5 text-xs font-semibold text-[#3B82F6] transition-colors hover:bg-slate-800 hover:text-[#3B82F6]/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class=