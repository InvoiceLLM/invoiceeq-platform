exports[`InvoiceTable direction=out — parity with OutboundInvoicesTable > rows 1`] = `"<div class="glass-panel rounded-xl overflow-hidden flex flex-col h-full border border-[#222D3D]"><div class="p-6 border-b border-[#222D3D] flex items-center justify-between"><div><h3 class="text-sm font-semibold text-white tracking-wide">Outbound Invoices</h3><p class="text-xs text-slate-400">Invoices sent to customers, pre-send validation ledger.</p></div><div class="flex items-center gap-1 bg-[#0B0F19] border border-[#222D3D] rounded-lg p-1"><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">All</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Pending</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Paid</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors bg-[#3B82F6] text-white">Overdue</button></div></div><div class="overflow-x-auto overflow-y-auto" style="max-height: 320px;"><table class="w-full text-left border-collapse"><thead><tr class="sticky top-0 z-10 border-b border-[#222D3D] bg-[#0F172A] text-slate-400 text-[10px] font-bold uppercase tracking-wider select-none"><th class="px-6 py-3.5">Invoice #</th><th class="px-6 py-3.5">Customer</th><th class="px-6 py-3.5">Issue Date</th><th class="px-6 py-3.5">Amount</th><th class="px-6 py-3.5">Status</th><th class="px-6 py-3.5 text-right">Actions</th></tr></thead><tbody class="divide-y divide-[#222D3D]/50 text-slate-300 text-xs"><tr class="hover:bg-slate-900/30 transition-colors duration-150 group"><td class="px-6 py-4 font-mono font-medium text-white group-hover:text-[#3B82F6] transition-colors">INV-1042</td><td class="px-6 py-4"><span class="font-semibold text-slate-200">Northwind</span></td><td class="px-6 py-4 font-medium text-slate-400">Aug 1, 2026</td><td class="px-6 py-4 font-bold text-slat