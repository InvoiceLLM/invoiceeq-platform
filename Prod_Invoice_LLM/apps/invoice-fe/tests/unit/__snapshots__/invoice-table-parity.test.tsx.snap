exports[`InvoiceTable direction=in — parity with RecentInvoicesTable > empty, single page 1`] = `"<div class="glass-panel rounded-xl overflow-hidden flex flex-col h-full border border-[#222D3D]"><div class="p-6 border-b border-[#222D3D] flex items-center justify-between"><div><h3 class="text-sm font-semibold text-white tracking-wide">Recent Invoices</h3><p class="text-xs text-slate-400">Audit history status and processing ledger.</p></div><div class="flex items-center gap-1 bg-[#0B0F19] border border-[#222D3D] rounded-lg p-1"><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">All</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors bg-[#3B82F6] text-white">Review Required</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Paid</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Pending</button><button class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors text-slate-400 hover:text-slate-200">Rejected</button></div></div><div class="overflow-x-auto overflow-y-auto" style="max-height: 320px;"><table class="w-full text-left border-collapse"><thead><tr class="sticky top-0 z-10 border-b border-[#222D3D] bg-[#0F172A] text-slate-400 text-[10px] font-bold uppercase tracking-wider select-none"><th class="px-6 py-3.5">Invoice #</th><th class="px-6 py-3.5">Client / Vendor</th><th class="px-6 py-3.5">Issue Date</th><th class="px-6 py-3.5">Ingest Date</th><th class="px-6 py-3.5">Due Date</th><th class="px-6 py-3.5">Amount</th><th class="px-6 py-3.5">AI Status</th><th class="px-6 py-3.5 text-right">Actions</th></tr></thead><tbody class="divide-y divide-[#222D3D]/50 text-slate-300 text-xs"><tr><td colspan="8" class="px-6 py-8 text-center text-slate-500">No invoices matched the active filters.</td></tr></tbody></table></div></div>"`;

