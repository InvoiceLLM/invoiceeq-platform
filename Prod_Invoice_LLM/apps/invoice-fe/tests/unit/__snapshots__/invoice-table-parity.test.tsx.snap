exports[`outbound builder page — parity after extracting OutboundBuilder > no ?source= is an explained error 1`] = `"<div data-testid="header-actions"></div><div class="flex h-96 flex-col items-center justify-center gap-3 px-6 text-center text-slate-400" data-testid="builder-load-error"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x text-red-400"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg><p class="max-w-md text-sm">No source invoice was given. Start from an existing invoice's Clone action.</p><a href="/invoices" class="inline-flex items-center gap-1.5 rounded-lg border border-[#222D3D] px-3 py-1.5 text-xs font-semibold text-slate-300 transition hover:border-slate-500 hover:text-slate-100"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Back to invoices</a></div>"`;

exports[`outbound builder page — parity after extracting OutboundBuilder > renders the loaded form and its header actions 1`] = `"<div data-testid="header-actions"><a href="/invoices/outbound-review/11111111-1111-1111-1111-111111111111" data-testid="builder-source-link" class="whitespace-nowrap rounded-lg border border-[#222D3D] px-2 sm:px-3 py-1 sm:py-1.5 text-[10px] sm:text-xs font-medium text-slate-300 transition hover:border-slate-500 hover:text-slate-100">Cloned from source invoice</a><button data-testid="create-invoice" class="flex items-center gap-1.5 whitespace-nowrap rounded-lg border border-emerald-500/50 bg-emerald-600/20 px-2 sm:px-3 py-1 sm:py-1.5 text-[10px] sm:text-xs font-semibold text-emerald-300 transition hover:bg-emerald-600/40 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-plus2"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M3 15h6"></path><path d="M6 12v6"></path></svg>Create invoice</button></div><div class="flex h-full flex-col gap-4 p-6 overflow-y-auto custom-scrollbar"><div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]"><div class="flex flex-col gap-4"><section data-testid="builder-form" class="flex flex-col rounded-xl border border-[#222D3D] bg-[#0F172A] overflow-hidden"><div class="flex items-center justify-between gap-2 border-b border-[#222D3D] bg-[#0B1220] px-4 py-2.5"><p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Invoice Details</p><span class="shrink-0 rounded-md border border-[#222D3D] px-2 py-0.5 text-[11px] text-slate-500">Copied from the source — edit what changes</span></div><div class="flex flex-col gap-3 p-4"><div class="flex flex-col gap-1" data-testid="builder-field-customer-name"><label for="builder-customer-name" class="flex items-center gap-1.5 text-xs font-medium text-slate-500">Customer</label><input id="builder-customer-name" data-testid="builder-input-customer-name" type="text" class="w-full rounded-lg border px-3 py-2 text-sm outline-none transition-colors disabled:cursor-not-allowed disabled:opacity-60 border-[#222D3D] bg-[#1E293B] text-slate-200 focus:border-blue-500" value="Northwind Traders"></div><div class="flex flex-col gap-1" data-testid="builder-field-vendor-name"><label for="builder-vendor-name" class="flex items-center gap-1.5 text-xs font-medium text-slate-500">Your Business Name</label><input id="builder-vendor-name" data-testid="builder-input-vendor-name" type="text" class="w-full rounded-lg border px-3 py-2 text-sm outline-none transition-colors disabled:cursor-not-allowed disabled:opacity-60 border-[#222D3D] bg-[#1E293B] text-slate-200 focus:border-blue-500" value="E2E Co"></div><div class="flex flex-col gap-1" data-testid="builder-field-invoice-number"><label for="builder-invoice-number" class="flex items-center gap-1.5 text-xs font-medium text-slate-500">Invoice Number</label><input id="builder-invoice-number" data-testid="builder-input-invoice-number" type="text" class="w-full rounded-lg border px-3 py-2 text-sm outline-none transition-colors disabled:cursor-not-allowed disabled:opacity-60 border-[#222D3D] bg-[#1E293B] text-slate-200 focus:border-blue-500" value="INV-1043"></div><div class="flex flex-col gap-1" data-testid="builder-field-invoice-date"><label for="builder-invoice-date" class="flex items-center gap-1.5 text-xs font-medium text-slate-500">Invoice Date</label><input id="builder-invoice-date" data-testid="builder-input-invoice-date" type="date" class="w-full rounded-lg border px-3 py-2 text-sm outline-none transition-colors disabled:cursor-not-allowed disabled:opacity-60 border-[#222D3D] bg-[#1E293B] text-slate-200 focus:border-blue-500" value="2026-02-01"></div><div class="flex flex-col gap-1" data-testid="builder-field-due-date"><label for="builder-due-date" class="flex items-center gap-1.5 text-xs font-medium text-slate-500">Due Date</label><input id="builder-due-date" data-testid="builder-input-due-date" type="date" class="w-full rounded-lg border px-3 py-2 text-sm outline-none transition-colors disabled:cursor-not-allowed disabled:opacity-60 border-[#222D3D] bg-[#1E293B] text-slate-200 focus:border-blue-500" value="2026-03-03"></div><div class="flex flex-col gap-1" data-testid="builder-field-po-number"><label for="builder-po-number" class="flex items-center gap-1.5 text-xs font-medium text-slate-500">PO Number</label><input id="builder-po-number" data-testid="builder-input-po-number" type="text" class="w-full rounded-lg border px-3 py-2 text-sm outline-none transition-colors disabled:cursor-not-allowed disabled:opacity-60 border-[#222D3D] bg-[#1E293B] text-slate-200 focus:border-blue-500" value=""></div><div class="flex flex-col gap-1"><label for="builder-currency" class="text-xs font-medium text-slate-500">Currency</label><input id="builder-currency" data-testid="builder-input-currency" readonly="" title="Copied from the source invoice; not editable in v1." class="w-full cursor-not-allowed select-none rounded-lg border border-[#222D3D] bg-[#1E293B] px-3 py-2 text-sm text-slate-400" value="USD"></div></div><div class="flex flex-col gap-3 border-t border-[#222D3D] px-4 py-4"><p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Addresses</p><div class="flex flex-col gap-1" data-testid="builder-field-address-billing"><label for="builder-address-billing" class="text-xs font-medium text-slate-500">Bill To Address</label><textarea id="builder-address-billing" data-testid="builder-input-address-billing" rows="3" placeholder="Street, city, postcode" class="w-full resize-y rounded-lg border border-[#222D3D] bg-[#1E293B] px-3 py-2 text-sm text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60"></textarea></div><div class="flex flex-col gap-1" data-testid="builder-field-address-shipping"><label for="builder-address-shipping" class="text-xs font-medium text-slate-500">Ship To Address</label><textarea id="builder-address-shipping" data-testid="builder-input-address-shipping" rows="3" placeholder="Street, city, postcode" class="w-full resize-y rounded-lg border border-[#222D3D] bg-[#1E293B] px-3 py-2 text-sm text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60"></textarea></div><div class="flex flex-col gap-1" data-testid="builder-field-address-vendor"><label for="builder-address-vendor" class="text-xs font-medium text-slate-500">Your Address</label><textarea id="builder-address-vendor" data-testid="builder-input-address-vendor" rows="3" placeholder="Street, city, postcode" class="w-full resize-y rounded-lg border border-[#222D3D] bg-[#1E293B] px-3 py-2 text-sm text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60"></textarea></div></div><div class="flex flex-col gap-3 border-t border-[#222D3D] px-4 py-4"><p class="text-xs font-semibold uppercase tracking-widest text-slate-400">References &amp; Payment</p><div class="flex flex-col gap-1.5" data-testid="builder-list-references"><span class="text-xs font-medium text-slate-500">References</span><button type="button" data-testid="references-add" class="inline-flex w-fit items-center gap-1.5 rounded-lg border border-blue-500/40 bg-blue-600/10 px-2.5 py-1 text-[11px] font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3 w-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add references</button></div><div class="flex flex-col gap-1.5" data-testid="builder-list-payment-instructions"><span class="text-xs font-medium text-slate-500">Payment instructions</span><button type="button" data-testid="payment-instructions-add" class="inline-flex w-fit items-center gap-1.5 rounded-lg border border-blue-500/40 bg-blue-600/10 px-2.5 py-1 text-[11px] font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3 w-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add payment instructions</button></div><div class="flex flex-col gap-1" data-testid="builder-field-notes"><label for="builder-notes" class="text-xs font-medium text-slate-500">Notes / terms</label><textarea id="builder-notes" data-testid="builder-input-notes" rows="3" placeholder="Printed under the totals — payment terms, thanks, anything the invoice says." class="w-full resize-y rounded-lg border border-[#222D3D] bg-[#1E293B] px-3 py-2 text-sm text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60"></textarea></div></div><div class="flex flex-col gap-3 border-t border-[#222D3D] px-4 py-4"><p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Tax IDs &amp; Compliance</p><div class="flex flex-col gap-1.5" data-testid="builder-list-tax-ids"><span class="text-xs font-medium text-slate-500">Tax IDs</span><button type="button" data-testid="tax-ids-add" class="inline-flex w-fit items-center gap-1.5 rounded-lg border border-blue-500/40 bg-blue-600/10 px-2.5 py-1 text-[11px] font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3 w-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add tax ids</button></div><div class="flex flex-col gap-1.5" data-testid="builder-list-compliance-metadata"><span class="text-xs font-medium text-slate-500">Compliance metadata</span><button type="button" data-testid="compliance-metadata-add" class="inline-flex w-fit items-center gap-1.5 rounded-lg border border-blue-500/40 bg-blue-600/10 px-2.5 py-1 text-[11px] font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3 w-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add compliance metadata</button></div></div></section><section data-testid="line-item-grid" class="flex flex-col rounded-xl border border-[#222D3D] bg-[#0F172A] overflow-hidden"><div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#222D3D] bg-[#0B1220] px-4 py-2.5"><div class="flex items-center gap-2"><p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Line Items</p><span class="rounded bg-slate-800 px-2 py-0.5 font-mono text-[11px] text-slate-300 border border-slate-700">1 rows</span></div></div><div class="overflow-x-auto p-3"><table class="w-full min-w-[720px] border-collapse text-left"><thead><tr class="border-b border-[#222D3D] text-[10px] uppercase tracking-wide text-slate-500"><th class="pb-2 pr-3 font-medium">#</th><th class="pb-2 pr-3 font-medium">Description</th><th class="pb-2 pr-3 font-medium">HSN/SAC</th><th class="pb-2 pr-3 text-right font-medium">Qty</th><th class="pb-2 pr-3 font-medium">UOM</th><th class="pb-2 pr-3 text-right font-medium">Unit Price</th><th class="pb-2 pr-3 text-right font-medium">Disc %</th><th class="pb-2 pr-3 text-right font-medium">Tax %</th><th class="pb-2 pr-3 text-right font-medium">Amount</th><th class="pb-2 text-right font-medium"></th></tr></thead><tbody class="divide-y divide-[#222D3D]/60 text-xs text-slate-300"><tr data-testid="line-item-row-0"><td class="py-2 pr-3 text-slate-500">1</td><td class="py-2 pr-3"><input class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60" aria-label="Description row 1" data-testid="item-description-0" value="Consulting hours"></td><td class="py-2 pr-3"><input class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60 w-24" aria-label="HSN or SAC code row 1" data-testid="item-hsn-sac-0" value=""></td><td class="py-2 pr-3"><input class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60 text-right" inputmode="decimal" aria-label="Quantity row 1" data-testid="item-quantity-0" value="3"></td><td class="py-2 pr-3"><input class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60 w-20" aria-label="Unit of measure row 1" data-testid="item-uom-0" value=""></td><td class="py-2 pr-3"><input class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60 text-right" inputmode="decimal" aria-label="Unit price row 1" data-testid="item-unit-price-0" value="19.99"></td><td class="py-2 pr-3"><input class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60 w-20 text-right" inputmode="decimal" aria-label="Discount percent row 1" data-testid="item-discount-percent-0" value=""></td><td class="py-2 pr-3"><input class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60 w-20 text-right" inputmode="decimal" aria-label="Tax percent row 1" data-testid="item-tax-percent-0" value=""></td><td class="py-2 pr-3 text-right font-medium text-slate-200" data-testid="item-amount-0">$59.97</td><td class="py-2 text-right"><button type="button" disabled="" title="An invoice needs at least one line" aria-label="Remove row 1" data-testid="remove-row-0" class="inline-flex items-center rounded-lg p-1.5 text-rose-400 transition-colors hover:bg-rose-500/10 hover:text-rose-300 disabled:cursor-not-allowed disabled:opacity-40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 h-3.5 w-3.5"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></td></tr></tbody></table><button type="button" data-testid="add-row" class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-blue-500/40 bg-blue-600/10 px-3 py-1.5 text-xs font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add row</button></div><div class="border-t border-[#222D3D] bg-[#0B1220] px-4 py-3"><dl class="ml-auto flex w-full max-w-md flex-col gap-1.5 text-xs"><div class="flex items-center justify-between text-slate-400"><dt>Subtotal</dt><dd data-testid="totals-subtotal" class="font-mono text-slate-200">$59.97</dd></div><div class="flex items-center justify-between text-slate-400"><dt><label for="builder-tax-amount">Tax</label></dt><dd><input id="builder-tax-amount" class="w-full rounded-md border border-[#222D3D] bg-[#1E293B] px-2 py-1.5 text-xs text-slate-200 outline-none transition-colors placeholder:text-slate-600 focus:border-blue-500 disabled:cursor-not-allowed disabled:opacity-60 w-28 text-right" inputmode="decimal" data-testid="tax-amount" value="10.00"></dd></div><div class="flex flex-wrap gap-1.5 pt-1"><button type="button" data-testid="add-discount" class="inline-flex items-center gap-1 rounded-lg border border-blue-500/40 bg-blue-600/10 px-2 py-1 text-[11px] font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3 w-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Discount</button><button type="button" data-testid="add-tax" class="inline-flex items-center gap-1 rounded-lg border border-blue-500/40 bg-blue-600/10 px-2 py-1 text-[11px] font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3 w-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Tax rate</button><button type="button" data-testid="add-deduction" class="inline-flex items-center gap-1 rounded-lg border border-blue-500/40 bg-blue-600/10 px-2 py-1 text-[11px] font-semibold text-blue-300 transition hover:bg-blue-600/25 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3 w-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Deduction</button></div><div class="flex items-center justify-between border-t border-[#222D3D] pt-1.5 text-sm font-semibold text-slate-100"><dt>Total</dt><dd data-testid="totals-grand-total" class="font-mono">$69.97</dd></div></dl></div></section><p class="text-[11px] text-slate-500">The invoice is laid out fresh from the source's logo and header, so rows can be added or removed freely. Totals are shown for your benefit and are recalculated on the server before anything is printed.</p></div><section data-testid="builder-preview" class="flex h-full min-h-[520px] flex-col gap-3"><div class="flex flex-wrap items-center gap-2"><button type="button" data-testid="preview-button" class="inline-flex items-center gap-1.5 rounded-lg border border-blue-500/50 bg-blue-600/20 px-3 py-1.5 text-xs font-semibold text-blue-200 transition hover:bg-blue-600/40 disabled:opacity-50"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>Preview PDF</button></div><div data-testid="preview-placeholder" class="flex flex-1 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-[#222D3D] bg-[#0B1220] text-xs text-slate-500"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg><p>Preview renders the real PDF the backend will produce. Nothing is saved.</p></div></section></div></div>"`;
