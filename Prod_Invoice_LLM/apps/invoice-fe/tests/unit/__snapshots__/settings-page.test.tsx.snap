exports[`/settings with the four surfaces OFF — the tile grid, unchanged > Admin 1`] = `"<div class="h-full flex flex-col bg-[#0B0F19] text-slate-100 overflow-auto font-sans"><main class="flex-1 px-6 py-6 max-w-5xl w-full mx-auto space-y-6"><section aria-labelledby="service-flow-heading"><div class="mb-3"><h2 id="service-flow-heading" class="text-xs font-semibold uppercase tracking-wider text-slate-500">Service Flow</h2><p class="text-[11px] text-slate-500 mt-0.5">Control which invoice directions are active for your workspace.</p></div><div data-testid="service-flow-toggles" data-role="Admin"></div></section><hr class="border-[#1E293B]"><section aria-labelledby="integrations-heading"><h2 id="integrations-heading" class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Integrations &amp; Management</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"><a href="/settings/workflows" class="group flex items-start gap-3 px-4 py-3.5 rounded-xl bg-[#111827] border border-[#1E293B] hover:border-[#334155] hover:bg-[#151D2E] transition-all"><div class="w-8 h-8 rounded-lg border flex items-center justify-center shrink-0 bg-indigo-500/10 border-indigo-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-workflow w-4 h-4 text-indigo-400"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg></div><div class="min-w-0"><p class="text-sm font-medium text-white group-hover:text-blue-200 transition-colors">Workflows</p><p class="text-[11px] text-slate-500 mt-0.5 leading-tight">Plug &amp; play setup — inputs, audit policy, outputs &amp; chat access</p></div></a><a href="/settings/connectors" class="group flex items-start gap-3 px-4 py-3.5 rounded-xl bg-[#111827] border border-[#1E293B] hover:borde