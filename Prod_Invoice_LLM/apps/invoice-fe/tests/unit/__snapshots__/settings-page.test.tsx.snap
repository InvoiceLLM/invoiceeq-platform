[#334155] hover:bg-[#151D2E] transition-all"><div class="w-8 h-8 rounded-lg border flex items-center justify-center shrink-0 bg-blue-500/10 border-blue-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-credit-card w-4 h-4 text-blue-400"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg></div><div class="min-w-0"><p class="text-sm font-medium text-white group-hover:text-blue-200 transition-colors">Subscriptions</p><p class="text-[11px] text-slate-500 mt-0.5 leading-tight">Plan limits, billing cycle &amp; upgrades</p></div></a><a href="/settings/webhooks" class="group flex items-start gap-3 px-4 py-3.5 rounded-xl bg-[#111827] border border-[#1E293B] hover:border-[#334155] hover:bg-[#151D2E] transition-all"><div class="w-8 h-8 rounded-lg border flex items-center justify-center shrink-0 bg-violet-500/10 border-violet-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-webhook w-4 h-4 text-violet-400"><path d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9A4 4 0 0 1 2 17c.01-.7.2-1.4.57-2"></path><path d="m6 17 3.13-5.78c.53-.97.1-2.18-.5-3.1a4 4 0 1 1 6.89-4.06"></path><path d="m12 6 3.13 5.73C15.66 12.7 16.9 13 18 13a4 4 0 0 1 0 8"></path></svg></div><div class="min-w-0"><p class="text-sm font-medium text-white group-hover:text-blue-200 transition-colors">Webhooks</p><p class="text-[11px] text-slate-500 mt-0.5 leading-tight">HTTP callback endpoints for status updates</p></div></a><a href="/settings/security" class="group flex items-start gap-3 px-4 py-3.5 rounded-xl bg-[#111827] border border-[#1E293B] hover:border-[#334155] hover:bg-[#151D2E] transition-all"><div class="w-8 h-8 rounded-lg border flex items-center justify-center shrink-0 bg-emerald-500/10 border-emerald-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-4 h-4 text-emerald-400"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></div><div class="min-w-0"><p class="text-sm font-medium text-white group-hover:text-blue-200 transition-colors">Security</p><p class="text-[11px] text-slate-500 mt-0.5 leading-tight">API keys, audit logs &amp; access control</p></div></a></div></section></main></div>"`;
