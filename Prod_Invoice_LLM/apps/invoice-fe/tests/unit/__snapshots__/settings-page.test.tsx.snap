exports[`/settings with the four surfaces OFF — the tile grid, unchanged > non-Admin (admin-only tiles hidden) 1`] = `"<div class="h-full flex flex-col bg-[#0B0F19] text-slate-100 overflow-auto font-sans"><main class="flex-1 px-6 py-6 max-w-5xl w-full mx-auto space-y-6"><section aria-labelledby="service-flow-heading"><div class="mb-3"><h2 id="service-flow-heading" class="text-xs font-semibold uppercase tracking-wider text-slate-500">Service Flow</h2><p class="text-[11px] text-slate-500 mt-0.5">Control which invoice directions are active for your workspace.</p></div><div data-testid="service-flow-toggles" data-role="Auditor"></div></section><hr class="border-[#1E293B]"><section aria-labelledby="integrations-heading"><h2 id="integrations-heading" class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Integrations &amp; Management</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"><a href="/settings/connectors" class="group flex items-start gap-3 px-4 py-3.5 rounded-xl bg-[#111827] border border-[#1E293B] hover:border-[#334155] hover:bg-[#151D2E] transition-all"><div class="w-8 h-8 rounded-lg border flex items-center justify-center shrink-0 bg-cyan-500/10 border-cyan-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-sync w-4 h-4 text-cyan-400"><path d="M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v.5"></path><path d="M12 10v4h4"></path><path d="m12 14 1.535-1.605a5 5 0 0 1 8 1.5"></path><path d="M22 22v-4h-4"></path><path d="m22 18-1.535 1.605a5 5 0 0 1-8-1.5"></path></svg></div><div class="min-w-0"><p class="text-sm font-medium text-white group-hover:text-blue-200 transition-colors">Connectors</p><p class="text-[11px] text-slate-500 mt-0.5 leading-tight">Google Drive folder mapping</p></div></a><a href="/setting