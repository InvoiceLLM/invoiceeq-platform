# Database Connections (Local Container Defaults)
DATABASE_URL=postgresql://postgres:localpassword123@localhost:5432/invoice_db
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Azure Cognitive Services / OCR Configuration
AZURE_DOC_INTEL_ENDPOINT=https://<your-doc-intel-name>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your_azure_doc_intelligence_key_here

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Azure OpenAI API Configuration (RAG & Agent Reasoning)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://<your-openai-name>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
# Gap 466 (2026-09-06): role deployments. dev = gpt-5.6-luna primary+fast, gpt-5-mini judge (pinned so eval scores stay comparable).
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.6-luna
AZURE_OPENAI_FAST_DEPLOYMENT_NAME=gpt-5.6-luna
AZURE_OPENAI_JUDGE_DEPLOYMENT_NAME=gpt-5-mini
# Feature 29 (2026-09-06). One more role deployment, SAFE TO LEAVE BLANK.
# chat_summary: the model that narrates a full-record chat turn (decision 2 --
#   gpt-5-mini, measured 22.2% -> 52.8% on the golden set). Blank falls back to
#   the JUDGE deployment, which is already gpt-5-mini, so blank is correct today.
# (The long_doc role was removed 2026-09-07 -- Gap 489: Luna matched Terra 3/3.)
AZURE_OPENAI_CHAT_SUMMARY_DEPLOYMENT_NAME=
# BE Feature 35 task 35.0 (2026-09-20). atlas: ATLAS Intelligence briefing role,
# gpt-5.6-terra recreated on dev for its long-context recall (MRCR 89%+).
# Blank falls back to AZURE_OPENAI_DEPLOYMENT_NAME (resolve_model("atlas")).
AZURE_OPENAI_ATLAS_DEPLOYMENT_NAME=gpt-5.6-luna

# SSO User Authentication Configurations
# Ask the repo owner for the shared dev-instance value.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk JWT verification. BOTH are required for real tokens to work:
#   - CLERK_JWKS_URL empty  -> get_jwk() raises HTTP 500 on every real token
#   - CLERK_JWT_ISSUER empty -> issuer validation is silently SKIPPED, so a
#     correctly signed token from any other Clerk tenant would be accepted
# No trailing slash on the issuer: PyJWT compares `iss` by exact string match.
# Values below are the shared team dev instance (real-stallion-21).
CLERK_JWT_ISSUER=https://real-stallion-21.clerk.accounts.dev
CLERK_JWKS_URL=https://real-stallion-21.clerk.accounts.dev/.well-known/jwks.json

# Gap 4 — mock auth fallback (LOCAL DEVELOPMENT ONLY)
# When true, a request with no Authorization header (or a "Bearer test_*" token)
# resolves to a mock Admin context on the all-zero tenant instead of being
# rejected. That is a complete auth bypass, so it defaults to false in code and
# MUST stay false in every deployed environment.
# Set it true locally to keep the zero-config workflow described in
# docs/feature_1_auth.md; the pytest suite enables it itself via
# tests/conftest.py.
ALLOW_MOCK_AUTH=true
# Gap 359: required whenever ALLOW_MOCK_AUTH=true -- config.py refuses to
# start otherwise (a production deployment must never have both).
ENVIRONMENT=dev

# Token Encryption Key (Fernet AES-256 Key)
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here

# Connectors (Feature 9): ONE shared, company-owned OAuth app per provider --
# not per-tenant. Each end-user connects THEIR OWN Drive/Salesforce account
# through this app; the resulting per-tenant access/refresh token is what
# gets stored (see models.py::TenantConnection), not these values.
# Leave a field as "..._placeholder" (or empty) to keep that provider on the
# simulated/mock OAuth exchange for local testing (see
# routers/connectors.py::_has_real_credentials).
# FRONTEND_URL: where oauth_callback() redirects the browser back to once the
# provider's OAuth flow completes (Google/Salesforce hit this backend
# directly per GOOGLE_REDIRECT_URI below, so the backend must send the user
# back into the app itself). This targets an invoice-fe route
# (/settings/connectors). NOT used by billing -- see PUBLIC_APP_URL below.
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/callback/google_drive
SALESFORCE_CLIENT_ID=your_salesforce_consumer_key_placeholder
SALESFORCE_CLIENT_SECRET=your_salesforce_consumer_secret_placeholder
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/callback/salesforce

# Feature 11 — PayU Billing
# Merchant Key/Salt come from the PayU dashboard. PAYU_MODE picks which set of
# PayU hosts are used ("test" -> test.payu.in, "live" -> secure.payu.in).
PAYU_MERCHANT_KEY=your_payu_merchant_key_here
PAYU_MERCHANT_SALT=your_payu_merchant_salt_here
PAYU_MODE=test

# BACKEND_PUBLIC_URL: the public origin PayU POSTs surl/furl back to. Despite
# the name this is invoice-website's origin, NOT invoice-be's — invoice-be's
# Azure ingress is internal-only, so PayU can never reach it directly.
# invoice-website carries a verbatim pass-through at the identical path
# (app/api/v1/billing/payu/{success,failure}) that forwards the raw form body
# to this backend and relays the 303 back to the browser.
BACKEND_PUBLIC_URL=http://localhost:3000

# PUBLIC_APP_URL: where routers/billing.py sends the *user* after PayU
# (/billing/success, /billing/failed). Both pages live in invoice-website, so
# this is the website origin too. Kept separate from FRONTEND_URL because that
# one targets an invoice-fe route and the two differ in local dev.
PUBLIC_APP_URL=http://localhost:3000

# Gap 12 / FE Gap 181 — Bulk Directory Scan's server-path watcher. Empty =
# feature disabled (routers/invoices.py returns 501 "Directory watcher isn't
# enabled for this environment" on every scan request — this is the confirmed
# root cause behind reports that server-path scanning "doesn't work locally").
# Path-traversal guard: only directory_path values inside this base dir are
# ever scanned/read. ./watched_invoices is a git-tracked empty folder
# (watched_invoices/.gitkeep) scoped to this repo, not a real filesystem path
# -- drop test PDFs in there to exercise the "OR SERVER PATH" input locally.
WATCHER_ALLOWED_BASE_DIR=./watched_invoices

# LangSmith Tracing & Evaluation Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=invoice-llm-be

# Feature 20 Area 1 — Azure cost visibility (services/azure_cost.py).
# Both of the first two must be set or every cost call is skipped: cost_scope()
# raises rather than guessing, because a wrong scope returns a valid-looking
# response for somebody else's spend. Live dev values shown.
AZURE_SUBSCRIPTION_ID=
AZURE_COST_RESOURCE_GROUP=rg-invoice-llm-dev
# Empty = the deployed budget, budget-invoicellm-dev.
AZURE_COST_BUDGET_NAME=
# Local development only. In Azure, auth is the container's managed identity
# (AZURE_CLIENT_ID + the Cost Management Reader role). Leave both of these unset
# in any deployed environment -- the CLI fallback is off by default on purpose,
# so a deployment that lost its identity raises instead of silently running as
# whoever last ran `az login`.
AZURE_COST_CLI_FALLBACK=false
AZURE_COST_ACCESS_TOKEN=

# Feature 23 benchmark artifacts (services/benchmark_artifacts.py). Where the
# two benchmark tracks' full raw JSON output goes, so a workbook panel's
# extraction_benchmark_run / agent_eval_summary event can be followed back to
# the per-case / per-turn detail behind it. Its own container, not a prefix
# inside `invoices` -- that one holds tenant PDFs.
BENCHMARK_ARTIFACT_CONTAINER=benchmark-artifacts
# Only consulted when AZURE_STORAGE_CONNECTION_STRING is unset/placeholder: the
# managed-identity path needs the account name because there is no connection
# string to read it out of. `id-invoicellm-dev` already holds Storage Blob Data
# Contributor on `stinvoicellmdev2`, so no new role assignment is required.
AZURE_STORAGE_ACCOUNT=
# Set false for a local run that must not touch Azure Storage at all. The
# telemetry event is still emitted; it simply carries no artifact link.
BENCHMARK_ARTIFACT_UPLOAD=true

# Feature 24 (Ops Digest Agent) had seven OPS_DIGEST_* variables here. It was
# superseded as over-scoped and deleted 2026-08-25 (BE Gap 311). Nothing reads
# them; a stale OPS_DIGEST_* line in a local .env is ignored, not an error.

# ── BE Gap 681 — PDF page ceiling (intake validation) ────────────────────────
# Hard ceiling on pages in an uploaded PDF, and in a PDF produced by converting
# a multi-frame image. Above it, intake rejects with HTTP 400 naming both the
# limit and the actual count. 50 comes from corpus measurement: 68 PDFs
# scanned, largest was 11 pages, so this is ~4.5x headroom.
MAX_PDF_PAGES=50
# Log-only mode. true records an over-limit document with its page count and
# accepts it anyway. This is the rollback lever for Gap 681 -- a wrongly-tuned
# ceiling stops rejecting customer uploads without shipping code.
SHADOW_MODE_MAX_PDF_PAGES=false

# ── BE Gap 682 — complexity classifier thresholds ───────────────────────────
# COMPLEX routes a document through dynamic_qa_node, a second full LLM
# reasoning call (measured at 24-53 s across two calls), so these decide who
# pays for a pre-analysis pass. The pre-Gap-682 classifier triggered on the
# mere presence of a Doc Intelligence field -- `Items` is on every itemised
# invoice -- and on bare gst/vat/discount, so it fired on nearly everything.
#
# These values are PROVISIONAL: the COMPLEX rate has never been measured.
# `classify_invoice_complexity` logs the legacy verdict beside the new one on
# every call (`complexity_legacy`, `complexity_changed`), so tune these from
# App Insights rather than guessing.
COMPLEX_MIN_LINE_ITEMS=15
COMPLEX_MIN_TAX_ENTRIES=2
COMPLEX_DI_CONFIDENCE_FLOOR=0.70
# Rollback switch for Gap 682. true restores the previous trigger set.
USE_LEGACY_COMPLEXITY_CLASSIFIER=false
