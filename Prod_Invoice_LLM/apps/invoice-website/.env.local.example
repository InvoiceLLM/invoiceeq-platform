# ---------------------------------------------------------------------------
# invoice-website — local environment template
#
# Copy this file to .env.local, then fill in CLERK_SECRET_KEY (the only value
# not committed). Everything else already works as-is.
#
#   Windows:      copy .env.local.example .env.local
#   macOS/Linux:  cp .env.local.example .env.local
#
# .env.local is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Clerk (required) ------------------------------------------------------

# Publishable key for the shared team dev instance (real-stallion-21).
# Committed on purpose: publishable keys are public by design and already ship
# inside the browser bundle of every deployed Next.js app.
# Without this the app crashes on load with:
#   Error: @clerk/nextjs: Missing publishableKey
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cmVhbC1zdGFsbGlvbi0yMS5jbGVyay5hY2NvdW50cy5kZXYk

# Secret key — REQUIRED, and deliberately NOT committed.
# Ask the repo owner for the shared sk_test_... value and paste it here.
# Clerk's middleware needs this for server-side session verification.
CLERK_SECRET_KEY=

# --- Cross-app URLs (optional) ---------------------------------------------
# The code already falls back to these exact values when unset, so you only
# need to change them if you run the apps on different ports.

# invoice-fe origin, used for the post-login redirect (separate deployment,
# so it needs a full origin rather than an internal Next.js route).
NEXT_PUBLIC_FE_URL=http://localhost:3001

# Backend origin. Server-side ONLY — used by app/api/auth/provision/route.ts,
# which proxies to the backend because in Azure the backend Container App has
# internal-only ingress and the browser cannot reach it directly (Gap 7).
# Deliberately not a NEXT_PUBLIC_* value, so it never enters the client bundle.
BACKEND_API_URL=http://localhost:8000
