# ---------------------------------------------------------------------------
# invoice-website — local environment template
#
# Copy this file to .env.local, then fill in CLERK_SECRET_KEY (the only value
# not committed). Everything else already works as-is.
#
#   Windows:      copy .env.local.example .env.local
#   macOS/Linux:  cp .env.local.example .env.local
#
# .env.local is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Clerk (required) ------------------------------------------------------

# Publishable key for the shared team dev instance (real-stallion-21).
# Committed on purpose: publishable keys are public by design and already ship
# inside the browser bundle of every deployed Next.js app.
# Without this the app crashes on load with:
#   Error: @clerk/nextjs: Missing publishableKey
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cmVhbC1zdGFsbGlvbi0yMS5jbGVyay5hY2NvdW50cy5kZXYk

# Secret key — REQUIRED, and deliberately NOT committed.
# Ask the repo owner for the shared sk_test_... value and paste it here.
# Clerk's middleware needs this for server-side session verification.
CLERK_SECRET_KEY=

# --- Cross-app URLs (optional) ---------------------------------------------
# The code already falls back to these exact values when unset, so you only
# need to change them if you run the apps on different ports.

# invoice-fe origin, used for the post-login redirect (separate deployment,
# so it needs a full origin rather than an internal Next.js route).
NEXT_PUBLIC_FE_URL=http://localhost:3001

# Backend origin. Server-side ONLY — used by app/api/auth/provision/route.ts,
# app/api/billing/create-checkout-session/route.ts, and the PayU surl/furl
# pass-through at app/api/v1/billing/payu/{success,failure}/route.ts, all of
# which proxy to the backend because in Azure the backend Container App has
# internal-only ingress and neither a browser nor PayU can reach it directly
# (Gap 7 / Feature 11).
# Deliberately not a NEXT_PUBLIC_* value, so it never enters the client bundle.
BACKEND_API_URL=http://localhost:8000

# --- Sandbox API keys (optional, Gap 350) ----------------------------------
# Controls whether the homepage's "Choose Your Workflow" section renders the
# "Get Sandbox API Key" CTA at all. Leave unset (the default) and that section
# shows only the "Start Free Trial" link, exactly as it did before Gap 350.
#
# This MIRRORS invoice-be's own `SANDBOX_KEYS_ENABLED`, which also defaults to
# False. A mirror is not ideal, and it exists because there is no public
# endpoint that reports the backend's value -- the sandbox router 404s wholesale
# when it is off, and the only other way to ask is to call the issuance endpoint,
# which mints a tenant and burns the caller's rate-limit allowance, so it cannot
# be used as a probe.
#
# Turn the backend's on FIRST, then this. If this is true while the backend's is
# false, nothing breaks: the relay turns the backend's 404 into a plain
# "Sandbox keys aren't switched on yet" line next to the still-working
# "Start Free Trial" link.
#
# NEXT_PUBLIC_* values are baked into the browser bundle at `docker build` time
# (tracker Gap 6), so changing this needs a rebuild, not just a restart.
# NEXT_PUBLIC_SANDBOX_KEYS_ENABLED=true

# --- Billing return pages (optional) ---------------------------------------
# Shown as a "Contact support" mailto: on /billing/failed for the outcomes
# where a user may have been charged but the plan wasn't applied. Left unset
# by default because this repo has no support mailbox defined yet — when
# unset the page shows the instruction and transaction reference without a
# dead link, rather than inventing an address.
# NEXT_PUBLIC_SUPPORT_EMAIL=
