{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "4389869095397863390"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "caeId": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "userAssignedIdentityId": {
      "type": "string"
    },
    "userAssignedIdentityClientId": {
      "type": "string"
    },
    "keyVaultName": {
      "type": "string"
    },
    "chromaHost": {
      "type": "string"
    },
    "azureOpenAiEndpoint": {
      "type": "string"
    },
    "azureOpenAiDeploymentName": {
      "type": "string"
    },
    "azureDocIntelEndpoint": {
      "type": "string"
    },
    "clerkJwtIssuer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Clerk JWT issuer URL (public, no trailing slash)"
      }
    },
    "clerkJwksUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Clerk JWKS endpoint URL (public)"
      }
    },
    "allowedOrigins": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated allowed CORS origins (real FE/website FQDNs, computed by the orchestrator)"
      }
    },
    "googleClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Our company Google Cloud OAuth Client ID (connectors: Drive)"
      }
    },
    "googleRedirectUri": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "OAuth redirect URI registered with Google for this environment"
      }
    },
    "salesforceClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Our company Salesforce Connected App Consumer Key (connectors)"
      }
    },
    "salesforceRedirectUri": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "OAuth redirect URI registered with Salesforce for this environment"
      }
    },
    "sendgridSendingDomain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "SendGrid-authenticated domain used as the technical From for outbound mail (Gap 125) -- e.g. admsofttech.com"
      }
    },
    "sendgridFromEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Full From address for outbound emails -- e.g. invoices@outbound.invoicellm.admsofttech.com"
      }
    },
    "sendgridFromName": {
      "type": "string",
      "defaultValue": "InvoiceLLM Platform",
      "metadata": {
        "description": "Display name for outbound emails -- e.g. InvoiceLLM Platform"
      }
    },
    "emailAppDomain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Inbound mail domain (MX target for SendGrid Inbound Parse) -- e.g. inbound.invoicellm.admsofttech.com"
      }
    },
    "emailAppAddress": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Platform-wide mailbox address tenants send invoices to -- e.g. invoices@outbound.invoicellm.admsofttech.com"
      }
    },
    "supportNotifyEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Support / ops alert destination inbox -- never set to empty, that would silently swallow every ticket"
      }
    },
    "frontendUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Public browser origin for full-page redirects after connector OAuth (settings/connectors). Must be the invoice-website FQDN under Multi-Zone — FE is internal-only and returns Azure's \"stopped or does not exist\" page if the browser is sent there."
      }
    },
    "payuMode": {
      "type": "string",
      "defaultValue": "test",
      "metadata": {
        "description": "PayU environment: test -> test.payu.in, live -> secure.payu.in"
      }
    },
    "backendPublicUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Public origin PayU POSTs surl/furl to -- invoice-website FQDN (be ingress is internal-only; website relays /api/v1/billing/payu/*)"
      }
    },
    "publicAppUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Public origin for /billing/success and /billing/failed redirects after PayU -- invoice-website FQDN"
      }
    },
    "acrName": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azuredocs/aci-helloworld:latest"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application Insights Connection String for OpenTelemetry APM tracing"
      }
    },
    "enableProductionQualityJudge": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Score every real production chat turn with the online quality judge (Gap 304), writing an agent_eval_run row tagged run_source=production. Default false -- opt in per environment."
      }
    },
    "cpu": {
      "type": "string",
      "defaultValue": "1.0",
      "metadata": {
        "description": "vCPU allocation, e.g. '1.0'. Passed to json() below since Container Apps requires cpu as a decimal, not a string."
      }
    },
    "memory": {
      "type": "string",
      "defaultValue": "2.0Gi",
      "metadata": {
        "description": "Memory allocation, e.g. '2.0Gi'."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum replica count."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 5,
      "metadata": {
        "description": "Maximum replica count."
      }
    }
  },
  "variables": {
    "keyVaultUrl": "[format('https://{0}{1}', parameters('keyVaultName'), environment().suffixes.keyvaultDns)]"
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('userAssignedIdentityId'))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('caeId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": [
            {
              "server": "[format('{0}.azurecr.io', parameters('acrName'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            }
          ],
          "ingress": {
            "external": false,
            "targetPort": 8000,
            "transport": "http",
            "timeoutInSeconds": 120
          },
          "secrets": [
            {
              "name": "db-url-secret",
              "keyVaultUrl": "[format('{0}/secrets/DATABASE-URL', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "redis-url-secret",
              "keyVaultUrl": "[format('{0}/secrets/REDIS-URL', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "clerk-secret-secret",
              "keyVaultUrl": "[format('{0}/secrets/CLERK-SECRET-KEY', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "token-encryption-secret",
              "keyVaultUrl": "[format('{0}/secrets/TOKEN-ENCRYPTION-KEY', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "openai-key-secret",
              "keyVaultUrl": "[format('{0}/secrets/AZURE-OPENAI-API-KEY', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "docintel-key-secret",
              "keyVaultUrl": "[format('{0}/secrets/AZURE-DOC-INTEL-KEY', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "storage-conn-secret",
              "keyVaultUrl": "[format('{0}/secrets/AZURE-STORAGE-CONNECTION-STRING', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "google-client-secret-secret",
              "keyVaultUrl": "[format('{0}/secrets/GOOGLE-CLIENT-SECRET', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "salesforce-client-secret-secret",
              "keyVaultUrl": "[format('{0}/secrets/SALESFORCE-CLIENT-SECRET', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "sendgrid-key-secret",
              "keyVaultUrl": "[format('{0}/secrets/SENDGRID-API-KEY', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "sendgrid-inbound-secret",
              "keyVaultUrl": "[format('{0}/secrets/SENDGRID-INBOUND-SECRET', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "payu-merchant-key-secret",
              "keyVaultUrl": "[format('{0}/secrets/PAYU-MERCHANT-KEY', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            },
            {
              "name": "payu-merchant-salt-secret",
              "keyVaultUrl": "[format('{0}/secrets/PAYU-MERCHANT-SALT', variables('keyVaultUrl'))]",
              "identity": "[parameters('userAssignedIdentityId')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "invoice-be",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "env": [
                {
                  "name": "DATABASE_URL",
                  "secretRef": "db-url-secret"
                },
                {
                  "name": "REDIS_URL",
                  "secretRef": "redis-url-secret"
                },
                {
                  "name": "CHROMA_HOST",
                  "value": "[parameters('chromaHost')]"
                },
                {
                  "name": "CHROMA_PORT",
                  "value": "8000"
                },
                {
                  "name": "CLERK_SECRET_KEY",
                  "secretRef": "clerk-secret-secret"
                },
                {
                  "name": "CLERK_JWT_ISSUER",
                  "value": "[parameters('clerkJwtIssuer')]"
                },
                {
                  "name": "CLERK_JWKS_URL",
                  "value": "[parameters('clerkJwksUrl')]"
                },
                {
                  "name": "ALLOWED_ORIGINS",
                  "value": "[parameters('allowedOrigins')]"
                },
                {
                  "name": "TOKEN_ENCRYPTION_KEY",
                  "secretRef": "token-encryption-secret"
                },
                {
                  "name": "LLM_PROVIDER",
                  "value": "azure"
                },
                {
                  "name": "AZURE_OPENAI_ENDPOINT",
                  "value": "[parameters('azureOpenAiEndpoint')]"
                },
                {
                  "name": "AZURE_OPENAI_API_KEY",
                  "secretRef": "openai-key-secret"
                },
                {
                  "name": "AZURE_OPENAI_API_VERSION",
                  "value": "2024-02-15-preview"
                },
                {
                  "name": "AZURE_OPENAI_DEPLOYMENT_NAME",
                  "value": "[parameters('azureOpenAiDeploymentName')]"
                },
                {
                  "name": "AZURE_DOC_INTEL_ENDPOINT",
                  "value": "[parameters('azureDocIntelEndpoint')]"
                },
                {
                  "name": "AZURE_DOC_INTEL_KEY",
                  "secretRef": "docintel-key-secret"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[parameters('userAssignedIdentityClientId')]"
                },
                {
                  "name": "AZURE_STORAGE_CONNECTION_STRING",
                  "secretRef": "storage-conn-secret"
                },
                {
                  "name": "GOOGLE_CLIENT_ID",
                  "value": "[parameters('googleClientId')]"
                },
                {
                  "name": "GOOGLE_CLIENT_SECRET",
                  "secretRef": "google-client-secret-secret"
                },
                {
                  "name": "GOOGLE_REDIRECT_URI",
                  "value": "[parameters('googleRedirectUri')]"
                },
                {
                  "name": "SALESFORCE_CLIENT_ID",
                  "value": "[parameters('salesforceClientId')]"
                },
                {
                  "name": "SALESFORCE_CLIENT_SECRET",
                  "secretRef": "salesforce-client-secret-secret"
                },
                {
                  "name": "SALESFORCE_REDIRECT_URI",
                  "value": "[parameters('salesforceRedirectUri')]"
                },
                {
                  "name": "SENDGRID_API_KEY",
                  "secretRef": "sendgrid-key-secret"
                },
                {
                  "name": "INBOUND_PARSE_SHARED_SECRET",
                  "secretRef": "sendgrid-inbound-secret"
                },
                {
                  "name": "SENDGRID_SENDING_DOMAIN",
                  "value": "[parameters('sendgridSendingDomain')]"
                },
                {
                  "name": "SENDGRID_FROM_EMAIL",
                  "value": "[parameters('sendgridFromEmail')]"
                },
                {
                  "name": "SENDGRID_FROM_NAME",
                  "value": "[parameters('sendgridFromName')]"
                },
                {
                  "name": "EMAIL_APP_DOMAIN",
                  "value": "[parameters('emailAppDomain')]"
                },
                {
                  "name": "EMAIL_APP_ADDRESS",
                  "value": "[parameters('emailAppAddress')]"
                },
                {
                  "name": "SUPPORT_NOTIFY_EMAIL",
                  "value": "[parameters('supportNotifyEmail')]"
                },
                {
                  "name": "PAYU_MERCHANT_KEY",
                  "secretRef": "payu-merchant-key-secret"
                },
                {
                  "name": "PAYU_MERCHANT_SALT",
                  "secretRef": "payu-merchant-salt-secret"
                },
                {
                  "name": "PAYU_MODE",
                  "value": "[parameters('payuMode')]"
                },
                {
                  "name": "BACKEND_PUBLIC_URL",
                  "value": "[parameters('backendPublicUrl')]"
                },
                {
                  "name": "PUBLIC_APP_URL",
                  "value": "[parameters('publicAppUrl')]"
                },
                {
                  "name": "FRONTEND_URL",
                  "value": "[parameters('frontendUrl')]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[parameters('appInsightsConnectionString')]"
                },
                {
                  "name": "ENABLE_PRODUCTION_QUALITY_JUDGE",
                  "value": "[if(parameters('enableProductionQualityJudge'), 'true', 'false')]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 15,
                  "failureThreshold": 3,
                  "timeoutSeconds": 5
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health/readiness",
                    "port": 8000
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "failureThreshold": 3,
                  "timeoutSeconds": 5
                },
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "failureThreshold": 12,
                  "timeoutSeconds": 5
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-scaling",
                "http": {
                  "metadata": {
                    "concurrentRequests": "20"
                  }
                }
              },
              {
                "name": "cpu-scaling",
                "custom": {
                  "type": "cpu",
                  "metadata": {
                    "type": "Utilization",
                    "value": "85"
                  }
                }
              },
              {
                "name": "memory-scaling",
                "custom": {
                  "type": "memory",
                  "metadata": {
                    "type": "Utilization",
                    "value": "85"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn]"
    }
  }
}