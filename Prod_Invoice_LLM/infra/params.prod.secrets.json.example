      "value": "REPLACE_ME_GENERATE_FRESH_WITH_FERNET_GENERATE_KEY_DO_NOT_REUSE_DEV"
    },
    "googleClientSecret": {
      "value": "REPLACE_ME_PROD_GOOGLE_OAUTH_CLIENT_SECRET"
    },
    "salesforceClientSecret": {
      "value": "REPLACE_ME_PROD_SALESFORCE_CONNECTED_APP_CONSUMER_SECRET"
    },
    "sendgridApiKey": {
      "value": "REPLACE_ME_PROD_SENDGRID_MAIL_SEND_API_KEY"
    },
    "sendgridInboundSecret": {
      "value": "REPLACE_ME_PROD_SENDGRID_INBOUND_PARSE_SHARED_SECRET"
