    "dbAdminPassword": {
      "value": "REPLACE_ME_STRONG_PASSWORD_PROD_ONLY_NEVER_REUSE_DEV"
    },
    "clerkSecretKey": {
      "value": "REPLACE_ME_PROD_CLERK_SECRET_KEY"
    },
